; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Resource",
"class": "BattleGridData",
"language": "GDScript",
"path": "res://BattleGridData/BattleGridModel.gd"
}, {
"base": "Area2D",
"class": "Cell",
"language": "GDScript",
"path": "res://Cell/Cell.gd"
}, {
"base": "Resource",
"class": "EnemySpawnData",
"language": "GDScript",
"path": "res://LevelData/EnemySpawnData.gd"
}, {
"base": "Node",
"class": "EnemySpawnManager",
"language": "GDScript",
"path": "res://Main/EnemySpawnManager.gd"
}, {
"base": "Resource",
"class": "GridDataResource",
"language": "GDScript",
"path": "res://GridData/GridModel.gd"
}, {
"base": "Resource",
"class": "LevelConfiguration",
"language": "GDScript",
"path": "res://LevelData/LevelConfiguration.gd"
}, {
"base": "Resource",
"class": "MovementChannel",
"language": "GDScript",
"path": "res://Main/UnitMovement/MovementChannel.gd"
}, {
"base": "Area2D",
"class": "SelectableComponent",
"language": "GDScript",
"path": "res://Unit/UserUnit/SelectableComponent.gd"
}, {
"base": "Resource",
"class": "TurnData",
"language": "GDScript",
"path": "res://TurnData/TurnData.gd"
}, {
"base": "Node2D",
"class": "Unit",
"language": "GDScript",
"path": "res://Unit/Unit.gd"
}, {
"base": "Node",
"class": "UnitMovementManager",
"language": "GDScript",
"path": "res://Main/UnitMovement/UnitMovementManager.gd"
} ]
_global_script_class_icons={
"BattleGridData": "",
"Cell": "",
"EnemySpawnData": "",
"EnemySpawnManager": "",
"GridDataResource": "",
"LevelConfiguration": "",
"MovementChannel": "",
"SelectableComponent": "",
"TurnData": "",
"Unit": "",
"UnitMovementManager": ""
}

[application]

config/name="Group Battle Proto V 1"
run/main_scene="res://Main/Main.tscn"
config/icon="res://icon.png"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_environment="res://default_env.tres"
