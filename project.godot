}, {
"base": "Node",
"class": "UnitMovementManager",
"language": "GDScript",
"path": "res://Logic/Main/UnitMovement/UnitMovementManager.gd"
} ]
_global_script_class_icons={
"BattleGridData": "",
"Cell": "",
"ClickableComponent": "",
"EnemySpawnData": "",
