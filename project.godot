"language": "GDScript",
"path": "res://Model/GridData/GridModel.gd"
}, {
"base": "Resource",
"class": "LevelConfiguration",
"language": "GDScript",
"path": "res://Model/LevelData/LevelConfiguration.gd"
}, {
"base": "Resource",
