"path": "res://Logic/Main/AttackRangeVisualizer/SelectionComponent.gd"
}, {
"base": "Resource",
"class": "EnemySpawnData",
"language": "GDScript",
"path": "res://Model/LevelData/EnemySpawnData.gd"
}, {
"base": "Node",
"class": "EnemySpawnManager",
"language": "GDScript",
"path": "res://Logic/Main/EnemySpawnManager.gd"
}, {
"base": "Resource",
